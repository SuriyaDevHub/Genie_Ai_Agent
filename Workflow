<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Genie Bot Agentic AI — Architecture</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap');

  :root {
    --navy:    #0a1628;
    --navy2:   #0f2040;
    --blue:    #1a6fe8;
    --blue2:   #2d8af6;
    --cyan:    #00c8e8;
    --green:   #00e5a0;
    --amber:   #f5a623;
    --red:     #ff4d6a;
    --purple:  #9b6dff;
    --white:   #f0f4ff;
    --dim:     #6a8ab0;
    --card:    rgba(255,255,255,0.04);
    --border:  rgba(255,255,255,0.08);
    --glow-b:  rgba(26,111,232,0.35);
    --glow-c:  rgba(0,200,232,0.25);
    --glow-g:  rgba(0,229,160,0.25);
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    background: var(--navy);
    color: var(--white);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Animated grid background */
  body::before {
    content:'';
    position:fixed; inset:0; z-index:0;
    background-image:
      linear-gradient(rgba(26,111,232,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(26,111,232,0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events:none;
  }

  /* Radial glow */
  body::after {
    content:'';
    position:fixed; inset:0; z-index:0;
    background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(26,111,232,0.12), transparent 70%);
    pointer-events:none;
  }

  .page { position:relative; z-index:1; padding: 40px 48px 60px; max-width: 1480px; margin:0 auto; }

  /* ── Header ── */
  .header {
    display:flex; align-items:flex-start; justify-content:space-between;
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }
  .header-left {}
  .header-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size:11px; letter-spacing:0.18em;
    color: var(--cyan); text-transform:uppercase;
    margin-bottom:8px;
  }
  .header-title {
    font-size:30px; font-weight:700; line-height:1.15;
    background: linear-gradient(135deg, var(--white) 0%, var(--cyan) 100%);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
  }
  .header-sub {
    margin-top:8px; color:var(--dim); font-size:13px; font-weight:300;
  }
  .header-meta {
    display:flex; flex-direction:column; align-items:flex-end; gap:8px;
  }
  .tag {
    font-family:'IBM Plex Mono', monospace; font-size:10px;
    padding:4px 10px; border-radius:4px; letter-spacing:0.1em;
    font-weight:600;
  }
  .tag-blue  { background:rgba(26,111,232,0.18); color:var(--blue2); border:1px solid rgba(26,111,232,0.3); }
  .tag-cyan  { background:rgba(0,200,232,0.14);  color:var(--cyan);  border:1px solid rgba(0,200,232,0.3); }
  .tag-green { background:rgba(0,229,160,0.12);  color:var(--green); border:1px solid rgba(0,229,160,0.3); }

  /* ── Legend ── */
  .legend {
    display:flex; flex-wrap:wrap; gap:20px; margin-bottom:32px;
    padding:14px 20px; background:var(--card);
    border:1px solid var(--border); border-radius:10px;
  }
  .legend-item { display:flex; align-items:center; gap:8px; font-size:11px; color:var(--dim); }
  .legend-dot { width:10px; height:10px; border-radius:3px; flex-shrink:0; }

  /* ── Main canvas ── */
  .canvas { display:grid; gap:20px; }

  /* ── Row ── */
  .row { display:flex; gap:16px; align-items:stretch; }

  /* ── Section labels ── */
  .section-label {
    writing-mode:vertical-lr; transform:rotate(180deg);
    font-family:'IBM Plex Mono', monospace; font-size:10px;
    letter-spacing:0.2em; text-transform:uppercase; color:var(--dim);
    padding:0 4px; flex-shrink:0; display:flex; align-items:center;
  }

  /* ── Arrow connectors ── */
  .arrow-col {
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    width:32px; flex-shrink:0; gap:2px;
  }
  .arrow-line { width:2px; flex:1; background:linear-gradient(to bottom, var(--border), var(--blue), var(--border)); min-height:20px; }
  .arrow-head { font-size:14px; color:var(--blue2); line-height:1; }
  .arrow-label { font-size:9px; color:var(--dim); writing-mode:vertical-lr; transform:rotate(180deg); letter-spacing:0.1em; }

  .arrow-row {
    display:flex; align-items:center; justify-content:center;
    height:28px; gap:4px; width:100%;
  }
  .arrow-row-line { height:2px; flex:1; background:linear-gradient(to right, transparent, var(--blue2), transparent); }
  .arrow-row-head { font-size:14px; color:var(--blue2); }

  /* ── Cards ── */
  .card {
    border-radius:12px; border:1px solid var(--border);
    background:var(--card);
    backdrop-filter:blur(8px);
    padding:16px 18px;
    position:relative; overflow:hidden;
    transition:transform 0.2s, box-shadow 0.2s;
  }
  .card:hover { transform:translateY(-2px); }

  .card::before {
    content:''; position:absolute; top:0; left:0; right:0; height:2px;
    border-radius:12px 12px 0 0;
  }
  .card-blue::before   { background: linear-gradient(90deg, var(--blue), var(--cyan)); box-shadow:0 0 20px var(--glow-b); }
  .card-green::before  { background: linear-gradient(90deg, var(--green), #00b890); box-shadow:0 0 20px var(--glow-g); }
  .card-amber::before  { background: linear-gradient(90deg, var(--amber), #ff8c00); }
  .card-red::before    { background: linear-gradient(90deg, var(--red), #ff8080); }
  .card-purple::before { background: linear-gradient(90deg, var(--purple), #c084fc); }
  .card-cyan::before   { background: linear-gradient(90deg, var(--cyan), var(--blue2)); box-shadow:0 0 20px var(--glow-c); }
  .card-dim::before    { background: linear-gradient(90deg, var(--dim), #4a6a90); }

  .card-title {
    font-family:'IBM Plex Mono', monospace;
    font-size:10px; font-weight:700; letter-spacing:0.12em;
    text-transform:uppercase; margin-bottom:8px;
    display:flex; align-items:center; gap:6px;
  }
  .card-title-blue   { color:var(--blue2); }
  .card-title-green  { color:var(--green); }
  .card-title-amber  { color:var(--amber); }
  .card-title-red    { color:var(--red); }
  .card-title-purple { color:var(--purple); }
  .card-title-cyan   { color:var(--cyan); }
  .card-title-dim    { color:var(--dim); }

  .card-name {
    font-size:15px; font-weight:700; color:var(--white); margin-bottom:4px; line-height:1.2;
  }
  .card-desc { font-size:11px; color:var(--dim); line-height:1.5; }

  .bullet-list { margin-top:8px; display:flex; flex-direction:column; gap:4px; }
  .bullet { display:flex; gap:6px; font-size:11px; color:var(--dim); line-height:1.4; }
  .bullet-dot { color:var(--blue2); flex-shrink:0; margin-top:1px; }

  .metric-chip {
    display:inline-flex; align-items:center; gap:4px;
    font-family:'IBM Plex Mono', monospace; font-size:9px;
    padding:3px 7px; border-radius:4px; margin:3px 2px 0;
    font-weight:600;
  }
  .chip-green  { background:rgba(0,229,160,0.12); color:var(--green); border:1px solid rgba(0,229,160,0.25); }
  .chip-blue   { background:rgba(26,111,232,0.15); color:var(--blue2); border:1px solid rgba(26,111,232,0.3); }
  .chip-amber  { background:rgba(245,166,35,0.12); color:var(--amber); border:1px solid rgba(245,166,35,0.25); }
  .chip-red    { background:rgba(255,77,106,0.12); color:var(--red);   border:1px solid rgba(255,77,106,0.25); }
  .chip-cyan   { background:rgba(0,200,232,0.12);  color:var(--cyan);  border:1px solid rgba(0,200,232,0.25); }
  .chip-purple { background:rgba(155,109,255,0.12);color:var(--purple);border:1px solid rgba(155,109,255,0.25);}

  .divider { width:100%; height:1px; background:var(--border); margin:20px 0; }

  /* ── Bands: layers ── */
  .layer-band {
    border-radius:12px; border:1px solid var(--border);
    background:rgba(255,255,255,0.02); padding:20px;
    position:relative;
  }
  .layer-band-title {
    font-family:'IBM Plex Mono', monospace; font-size:10px;
    letter-spacing:0.18em; text-transform:uppercase;
    margin-bottom:16px; display:flex; align-items:center; gap:10px;
  }
  .layer-band-title::after {
    content:''; flex:1; height:1px; background:var(--border);
  }

  /* ── Flow arrows between bands ── */
  .flow-arrow {
    display:flex; align-items:center; justify-content:center;
    height:36px; position:relative;
  }
  .flow-arrow::before {
    content:''; position:absolute; left:50%; top:0; bottom:0;
    width:2px; background:linear-gradient(to bottom, var(--border), var(--blue2), var(--border));
    transform:translateX(-50%);
  }
  .flow-arrow-badge {
    font-size:9px; font-family:'IBM Plex Mono', monospace;
    padding:3px 8px; border-radius:20px; z-index:1;
    background:var(--navy2); border:1px solid var(--blue2);
    color:var(--blue2); letter-spacing:0.08em;
  }

  /* ── Decision diamond ── */
  .diamond-row {
    display:flex; align-items:center; justify-content:center;
    gap:16px; padding:4px 0;
  }
  .diamond {
    width:100px; height:56px; position:relative; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
  }
  .diamond::before {
    content:''; position:absolute; inset:4px;
    background:rgba(245,166,35,0.1); border:1.5px solid var(--amber);
    transform:rotate(45deg); border-radius:4px;
  }
  .diamond-text {
    position:relative; z-index:1; font-size:10px; font-weight:700;
    color:var(--amber); text-align:center; font-family:'IBM Plex Mono', monospace;
    line-height:1.3; padding:0 12px;
  }
  .decision-branch {
    display:flex; flex-direction:column; gap:8px; flex:1;
  }
  .decision-branch-label {
    font-size:9px; font-family:'IBM Plex Mono', monospace;
    color:var(--dim); letter-spacing:0.1em; text-align:center;
  }

  /* ── HITL Gate ── */
  .hitl {
    border:2px solid var(--green); border-radius:10px;
    background:rgba(0,229,160,0.05); padding:12px 16px;
    position:relative;
  }
  .hitl-badge {
    position:absolute; top:-10px; left:16px;
    font-family:'IBM Plex Mono', monospace; font-size:9px; font-weight:700;
    background:var(--navy); border:1.5px solid var(--green);
    color:var(--green); padding:2px 8px; border-radius:4px; letter-spacing:0.1em;
  }

  /* ── Terminal states ── */
  .terminal-row { display:flex; gap:16px; }
  .terminal {
    flex:1; border-radius:10px; padding:14px 16px;
    border:1.5px solid;
  }
  .terminal-resolved { border-color:var(--green); background:rgba(0,229,160,0.06); }
  .terminal-escalated { border-color:var(--blue2); background:rgba(26,111,232,0.08); }
  .terminal-title {
    font-family:'IBM Plex Mono', monospace; font-size:10px; font-weight:700;
    letter-spacing:0.1em; text-transform:uppercase; margin-bottom:6px;
  }
  .terminal-title-green { color:var(--green); }
  .terminal-title-blue  { color:var(--blue2); }

  /* ── Bottom layers (infra) ── */
  .infra-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
  .metric-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; }

  /* ── Number badges ── */
  .agent-num {
    display:inline-flex; align-items:center; justify-content:center;
    width:20px; height:20px; border-radius:50%; flex-shrink:0;
    font-family:'IBM Plex Mono', monospace; font-size:10px; font-weight:700;
    background:rgba(26,111,232,0.25); color:var(--blue2);
    border:1px solid rgba(26,111,232,0.4);
  }

  /* ── YAML config inline ── */
  .yaml-hint {
    font-family:'IBM Plex Mono', monospace; font-size:9px; color:var(--dim);
    background:rgba(255,255,255,0.03); border:1px solid var(--border);
    border-radius:4px; padding:4px 8px; margin-top:6px; line-height:1.6;
  }
  .yaml-key { color:var(--cyan); }
  .yaml-val { color:var(--green); }

  /* ── Footer ── */
  .footer {
    margin-top:36px; padding-top:20px; border-top:1px solid var(--border);
    display:flex; justify-content:space-between; align-items:center;
    font-size:10px; color:var(--dim); font-family:'IBM Plex Mono', monospace;
  }

  /* Column widths */
  .w-full { width:100%; }
  .flex-1 { flex:1; }
  .flex-2 { flex:2; }
  .flex-3 { flex:3; }
  .w-200 { width:200px; flex-shrink:0; }
  .w-160 { width:160px; flex-shrink:0; }
  .w-120 { width:120px; flex-shrink:0; }
</style>
</head>
<body>
<div class="page">

  <!-- ── HEADER ── -->
  <div class="header">
    <div class="header-left">
      <div class="header-eyebrow">◈ CIB Middle Office · SME Management & ML Analytics</div>
      <div class="header-title">Genie Bot Agentic AI Copilot</div>
      <div class="header-sub">Complete System Architecture — Multi-Agent Workflow · RAG Pipeline · Metrics Observability</div>
    </div>
    <div class="header-meta">
      <span class="tag tag-blue">GPT-4.1 · text-embedding-3-small</span>
      <span class="tag tag-cyan">FastAPI · React · WebSocket</span>
      <span class="tag tag-green">YAML-Driven · 6 Agents · 5 Metric Layers</span>
    </div>
  </div>

  <!-- ── LEGEND ── -->
  <div class="legend">
    <div class="legend-item"><div class="legend-dot" style="background:var(--blue2)"></div>AI Agent (LLM-powered)</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--green)"></div>HITL Gate (Human decision)</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--amber)"></div>Decision / Branch</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--cyan)"></div>Data / Tool call</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--red)"></div>Terminal: Resolved</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--purple)"></div>Metrics / Observability</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--dim)"></div>Infrastructure / Config</div>
  </div>

  <div class="canvas">

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 0 — USER ENTRY                                   -->
    <!-- ══════════════════════════════════════════════════════ -->
    <div class="layer-band">
      <div class="layer-band-title" style="color:var(--dim)">◈ Layer 0 · User Entry Point</div>
      <div class="row">
        <div class="card card-dim flex-1">
          <div class="card-title card-title-dim">⬡ Genie Bot C#.Net Desktop App</div>
          <div class="card-name">End User — Non-IT Business Ops</div>
          <div class="card-desc">Batch file fails on user's Windows machine. User clicks <strong style="color:var(--white)">"Diagnose Issue"</strong> button in the Genie Bot UI.</div>
          <div style="margin-top:8px">
            <span class="metric-chip chip-amber">Run ID captured</span>
            <span class="metric-chip chip-amber">User ID · Machine ID</span>
            <span class="metric-chip chip-amber">Timestamp</span>
          </div>
        </div>
        <div style="display:flex;align-items:center;width:120px;flex-shrink:0;flex-direction:column;justify-content:center;gap:4px">
          <div style="font-size:9px;color:var(--dim);font-family:'IBM Plex Mono';letter-spacing:0.1em">HTTP POST</div>
          <div style="height:2px;width:100%;background:linear-gradient(to right,var(--border),var(--blue2))"></div>
          <div style="font-size:16px;color:var(--blue2)">▶</div>
          <div style="font-size:9px;color:var(--dim);font-family:'IBM Plex Mono'">WebSocket</div>
        </div>
        <div class="card card-blue flex-1">
          <div class="card-title card-title-blue">⬡ React Frontend</div>
          <div class="card-name">Support Copilot UI</div>
          <div class="card-desc">9 workflow panels. State driven by WorkflowContext. Real-time progress via WebSocket. Plain English throughout — no technical jargon.</div>
          <div style="margin-top:8px">
            <span class="metric-chip chip-blue">IdlePanel</span>
            <span class="metric-chip chip-blue">FetchingPanel</span>
            <span class="metric-chip chip-blue">HitlGate1Panel</span>
            <span class="metric-chip chip-blue">TemplatePanel</span>
            <span class="metric-chip chip-blue">CompletePanel</span>
          </div>
        </div>
        <div style="display:flex;align-items:center;width:120px;flex-shrink:0;flex-direction:column;justify-content:center;gap:4px">
          <div style="font-size:9px;color:var(--dim);font-family:'IBM Plex Mono';letter-spacing:0.1em">REST + WS</div>
          <div style="height:2px;width:100%;background:linear-gradient(to right,var(--border),var(--cyan))"></div>
          <div style="font-size:16px;color:var(--cyan)">▶</div>
          <div style="font-size:9px;color:var(--dim);font-family:'IBM Plex Mono'">/workflow/*</div>
        </div>
        <div class="card card-cyan flex-1">
          <div class="card-title card-title-cyan">⬡ FastAPI Backend</div>
          <div class="card-name">Workflow Orchestrator</div>
          <div class="card-desc">State machine engine. Routes each trigger to the correct agent. Maintains session state. Pushes real-time updates via WebSocket.</div>
          <div class="yaml-hint">
            <span class="yaml-key">workflow:</span> <span class="yaml-val">standard_support.yaml</span><br/>
            <span class="yaml-key">bot:</span> <span class="yaml-val">genie_bot.yaml</span>
          </div>
        </div>
      </div>
    </div>

    <div class="flow-arrow"><div class="flow-arrow-badge">▼ trigger: user_clicked_diagnose</div></div>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 1 — CONTEXT COLLECTION                          -->
    <!-- ══════════════════════════════════════════════════════ -->
    <div class="layer-band">
      <div class="layer-band-title" style="color:var(--cyan)">◈ Layer 1 · Context Collection — asyncio.gather() parallel I/O</div>
      <div class="row">
        <div class="card card-cyan" style="flex:1.2">
          <div class="card-title card-title-cyan"><span class="agent-num">1</span>Context Collector Agent</div>
          <div class="card-name">Parallel Fetch — S3 + Jira + FAISS</div>
          <div class="card-desc">Runs three async tasks simultaneously. Total latency = slowest task (~2s), not sum (~6s).</div>
          <div class="bullet-list">
            <div class="bullet"><span class="bullet-dot">→</span>S3: fetch raw execution log by run_id + timestamp key</div>
            <div class="bullet"><span class="bullet-dot">→</span>Jira: search open tickets by error_hash custom field</div>
            <div class="bullet"><span class="bullet-dot">→</span>FAISS: semantic search top-5 similar incidents</div>
            <div class="bullet"><span class="bullet-dot">→</span>Masking layer: PII + financial ID redaction before anything leaves</div>
          </div>
          <div style="margin-top:8px">
            <span class="metric-chip chip-cyan">Emits: agent_run</span>
            <span class="metric-chip chip-cyan">p95 target &lt;3s</span>
          </div>
        </div>
        <div style="width:16px;flex-shrink:0"></div>
        <div style="flex:2;display:flex;flex-direction:column;gap:12px">
          <div class="row">
            <div class="card card-dim flex-1" style="padding:12px">
              <div class="card-title card-title-dim" style="font-size:9px">☁ AWS S3</div>
              <div class="card-desc" style="font-size:10px">Read-only IAM role scoped to Genie Bot log prefix. Key: <code style="color:var(--cyan)">prod/genie/{Y}/{M}/{D}/{run_id}.log</code></div>
            </div>
            <div class="card card-dim flex-1" style="padding:12px">
              <div class="card-title card-title-dim" style="font-size:9px">🎫 Jira REST API v3</div>
              <div class="card-desc" style="font-size:10px">JQL: open tickets in project GBOT matching <code style="color:var(--cyan)">customfield_10100 = error_hash</code></div>
            </div>
            <div class="card card-dim flex-1" style="padding:12px">
              <div class="card-title card-title-dim" style="font-size:9px">🔍 FAISS Vector DB</div>
              <div class="card-desc" style="font-size:10px">text-embedding-3-small. Namespaced by bot_id. Cosine similarity. Returns top-5 with scores.</div>
            </div>
          </div>
          <div class="card card-dim" style="padding:12px">
            <div class="card-title card-title-dim" style="font-size:9px">📦 UnifiedContext Output</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <span class="metric-chip chip-cyan">parsed_log (masked)</span>
              <span class="metric-chip chip-cyan">error_hash (md5)</span>
              <span class="metric-chip chip-cyan">existing_jira[ ]</span>
              <span class="metric-chip chip-cyan">similar_incidents[ ]</span>
              <span class="metric-chip chip-cyan">top_score (0–1)</span>
              <span class="metric-chip chip-cyan">collection_duration_ms</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flow-arrow"><div class="flow-arrow-badge">▼ trigger: context_ready</div></div>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- LAYER 2 — DEDUP ROUTING                               -->
    <!-- ══════════════════════════════════════════════════════ -->
    <div class="layer-band">
      <div class="layer-band-title" style="color:var(--amber)">◈ Layer 2 · Deduplication Routing — Pure Python Logic (no LLM)</div>
      <div class="row" style="align-items:flex-start">
        <div class="card card-amber" style="width:280px;flex-shrink:0">
