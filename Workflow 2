<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Genie Bot AI Copilot — UML Activity Workflow</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@300;400;600;700&family=Source+Code+Pro:wght@400;600&family=Fira+Sans:wght@300;400;500;600&display=swap');

:root {
  /* Swimlane colours */
  --lane-user:    #f0f4ff;
  --lane-ai:      #f5f0ff;
  --lane-hitl:    #f0faf5;
  --lane-jira:    #fff8f0;
  --lane-hdr-user:#1e3a8a;
  --lane-hdr-ai:  #5b21b6;
  --lane-hdr-hitl:#065f46;
  --lane-hdr-jira:#92400e;

  /* Node fills */
  --node-user:    #dbeafe;
  --node-ai:      #ede9fe;
  --node-hitl:    #d1fae5;
  --node-jira:    #fef3c7;
  --node-sys:     #f1f5f9;
  --node-term-ok: #bbf7d0;
  --node-term-ko: #bfdbfe;
  --node-dec:     #fde68a;

  /* Strokes */
  --str-user:    #1e40af;
  --str-ai:      #6d28d9;
  --str-hitl:    #059669;
  --str-jira:    #b45309;
  --str-sys:     #64748b;
  --str-dec:     #d97706;
  --str-arrow:   #334155;

  /* Typography */
  --ink:   #0f172a;
  --muted: #64748b;
  --white: #ffffff;

  /* Layout */
  --lane-w: 210px;
  --gap: 0px;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
  background: #f8f7f4;
  font-family: 'Fira Sans', sans-serif;
  color: var(--ink);
}

/* ── WRAPPER ── */
.page {
  padding: 36px 44px 60px;
  max-width: 1420px;
  margin: 0 auto;
}

/* ── HEADER ── */
.doc-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-bottom: 18px;
  margin-bottom: 28px;
  border-bottom: 2.5px solid var(--ink);
}
.doc-title-block {}
.doc-eyebrow {
  font-family: 'Source Code Pro', monospace;
  font-size: 9px; letter-spacing: 0.22em;
  text-transform: uppercase; color: var(--muted);
  margin-bottom: 6px;
}
.doc-title {
  font-family: 'Source Serif 4', Georgia, serif;
  font-size: 24px; font-weight: 700; color: var(--ink);
  line-height: 1.2; margin-bottom: 4px;
}
.doc-sub {
  font-size: 12px; color: var(--muted); font-weight: 300;
}
.doc-meta {
  text-align: right;
  font-family: 'Source Code Pro', monospace;
  font-size: 9px; color: var(--muted);
  line-height: 1.8; letter-spacing: 0.05em;
}

/* ── LEGEND ── */
.legend-bar {
  display: flex; flex-wrap: wrap; gap: 16px;
  padding: 10px 16px;
  background: var(--white);
  border: 1px solid #e2e8f0;
  border-radius: 4px;
  margin-bottom: 24px;
  align-items: center;
}
.leg { display: flex; align-items: center; gap: 6px; font-size: 10px; color: var(--muted); }
.leg-shape { flex-shrink: 0; }

/* ── DIAGRAM CONTAINER ── */
.diagram {
  background: var(--white);
  border: 1.5px solid #cbd5e1;
  border-radius: 4px;
  overflow-x: auto;
}

/* ── SWIMLANE TABLE ── */
.swim-table {
  min-width: 1100px;
  width: 100%;
}

/* Lane headers row */
.lane-headers {
  display: grid;
  grid-template-columns: 48px var(--lane-w) var(--lane-w) var(--lane-w) var(--lane-w) var(--lane-w);
  border-bottom: 2px solid #334155;
}

.lane-hdr {
  padding: 10px 12px;
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--white); text-align: center;
  display: flex; align-items: center; justify-content: center;
  gap: 6px;
}
.lane-hdr-step { background: #334155; }
.lane-hdr-user { background: var(--lane-hdr-user); }
.lane-hdr-ai   { background: var(--lane-hdr-ai);   }
.lane-hdr-hitl { background: var(--lane-hdr-hitl); }
.lane-hdr-jira { background: var(--lane-hdr-jira); }
.lane-hdr-sys  { background: #374151; }

/* Each row of the swimlane */
.swim-row {
  display: grid;
  grid-template-columns: 48px var(--lane-w) var(--lane-w) var(--lane-w) var(--lane-w) var(--lane-w);
  border-bottom: 1px solid #e2e8f0;
  min-height: 80px;
}
.swim-row:last-child { border-bottom: none; }
.swim-row.row-sm  { min-height: 52px; }
.swim-row.row-md  { min-height: 96px; }
.swim-row.row-lg  { min-height: 120px; }
.swim-row.row-xl  { min-height: 140px; }
.swim-row.row-dec { min-height: 110px; }
.swim-row.row-branch { min-height: 100px; background: #fafaf8; }

/* Step number cell */
.step-cell {
  display: flex; align-items: center; justify-content: center;
  border-right: 1px solid #e2e8f0;
  background: #f8fafc;
  font-family: 'Source Code Pro', monospace;
  font-size: 10px; font-weight: 600; color: var(--muted);
  writing-mode: vertical-lr; transform: rotate(180deg);
  letter-spacing: 0.1em;
}

/* Lane cell */
.lane-cell {
  padding: 10px 10px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  position: relative;
  border-right: 1px solid #e2e8f0;
}
.lane-cell:last-child { border-right: none; }

/* Background tints for lanes */
.lane-cell.lc-user { background: rgba(219,234,254,0.15); }
.lane-cell.lc-ai   { background: rgba(237,233,254,0.18); }
.lane-cell.lc-hitl { background: rgba(209,250,229,0.15); }
.lane-cell.lc-jira { background: rgba(254,243,199,0.18); }
.lane-cell.lc-sys  { background: rgba(248,250,252,0.5);  }

/* ── NODE SHAPES ── */

/* Rectangle — standard process */
.node-rect {
  width: 88%;
  border-radius: 4px;
  padding: 8px 10px;
  font-size: 11px; line-height: 1.45;
  text-align: center;
  border: 1.5px solid;
  position: relative;
}
.nr-user { background: var(--node-user); border-color: var(--str-user); color: var(--str-user); }
.nr-ai   { background: var(--node-ai);   border-color: var(--str-ai);   color: var(--str-ai);   }
.nr-hitl { background: var(--node-hitl); border-color: var(--str-hitl); color: var(--str-hitl); }
.nr-jira { background: var(--node-jira); border-color: var(--str-jira); color: var(--str-jira); }
.nr-sys  { background: var(--node-sys);  border-color: var(--str-sys);  color: var(--str-sys);  }

.node-name { font-weight: 700; font-size: 11px; margin-bottom: 2px; }
.node-detail { font-size: 9.5px; font-weight: 400; opacity: 0.85; line-height: 1.4; }

/* Diamond — decision */
.node-diamond-wrap {
  display: flex; align-items: center; justify-content: center;
  width: 88%;
}
.node-diamond {
  position: relative;
  width: 90px; height: 56px;
  display: flex; align-items: center; justify-content: center;
}
.node-diamond::before {
  content: '';
  position: absolute; inset: 2px;
  background: var(--node-dec);
  border: 1.5px solid var(--str-dec);
  transform: rotate(45deg); border-radius: 3px;
}
.node-diamond-text {
  position: relative; z-index: 1;
  font-size: 9px; font-weight: 700;
  color: #92400e; text-align: center;
  line-height: 1.3;
  padding: 0 8px;
}

/* Rounded rect — HITL gate */
.node-hitl-gate {
  width: 88%;
  border-radius: 24px;
  padding: 8px 12px;
  font-size: 11px; line-height: 1.45;
  text-align: center;
  background: var(--node-hitl);
  border: 2px solid var(--str-hitl);
  color: var(--str-hitl);
}

/* Oval — terminal start/end */
.node-oval {
  width: 72px; height: 28px;
  border-radius: 50px;
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; font-weight: 700;
  border: 2px solid;
}
.oval-start { background: var(--ink); border-color: var(--ink); color: var(--white); }
.oval-end-ok { background: var(--str-hitl); border-color: var(--str-hitl); color: var(--white); }
.oval-end-ko { background: var(--str-user); border-color: var(--str-user); color: var(--white); }

/* Parallelogram — data/input/output */
.node-para {
  width: 88%;
  padding: 7px 10px;
  font-size: 10px; line-height: 1.4;
  text-align: center;
  background: #f0f9ff;
  border: 1.5px solid #0369a1;
  color: #0369a1;
  clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
}

/* Parallel bar — fork/join */
.fork-bar {
  width: 80%;
  height: 6px;
  background: var(--str-ai);
  border-radius: 2px;
  margin: 4px 0;
}

/* Note box */
.node-note {
  width: 88%;
  padding: 6px 8px;
  font-size: 9.5px; line-height: 1.4;
  background: #fffbeb;
  border: 1px dashed #d97706;
  color: #92400e;
  border-radius: 2px;
  position: relative;
}
.node-note::before {
  content: '';
  position: absolute; top: 0; right: 0;
  width: 10px; height: 10px;
  background: #d97706;
  clip-path: polygon(0 0, 100% 0, 100% 100%);
}

/* ── ARROWS ── */
/* Vertical arrow down (within same column) */
.v-arrow {
  display: flex; flex-direction: column; align-items: center;
  width: 100%; gap: 0; pointer-events: none;
}
.va-line {
  width: 1.5px;
  background: var(--str-arrow);
}
.va-head {
  font-size: 10px; color: var(--str-arrow); line-height: 1; margin-top: -1px;
}
.va-label {
  font-size: 8.5px; color: var(--muted);
  font-family: 'Source Code Pro', monospace;
  background: var(--white);
  padding: 1px 4px;
  border-radius: 2px;
  margin: 2px 0;
  letter-spacing: 0.04em;
  border: 1px solid #e2e8f0;
  white-space: nowrap;
}

/* ── CROSS-LANE ARROW (horizontal SVG) ── */
.cross-row {
  grid-column: 1 / -1;
  display: flex; align-items: center; justify-content: center;
  padding: 2px 0;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}
.cross-arrow-svg { overflow: visible; }

/* ── SECTION DIVIDER ── */
.section-div {
  grid-column: 1 / -1;
  background: #1e293b;
  padding: 5px 14px;
  display: flex; align-items: center; gap: 8px;
}
.section-div-text {
  font-family: 'Source Code Pro', monospace;
  font-size: 9px; letter-spacing: 0.18em;
  text-transform: uppercase; color: #94a3b8;
}
.section-div-line { flex:1; height:1px; background:rgba(255,255,255,0.08); }

/* ── BRANCH LABEL ── */
.branch-lbl {
  font-size: 9px;
  font-family: 'Source Code Pro', monospace;
  color: var(--muted);
  position: absolute;
  white-space: nowrap;
}

/* ── MULTI-CELL SPAN (for things that stretch across lanes) ── */
.span-all { grid-column: 2 / -1; }
.span-ai-hitl { grid-column: 3 / 5; }

/* ── GUARD condition tag ── */
.guard {
  display: inline-block;
  font-size: 8.5px; font-family: 'Source Code Pro', monospace;
  padding: 1px 5px; border-radius: 2px;
  background: #f1f5f9; border: 1px solid #cbd5e1;
  color: var(--muted); margin-top: 3px;
  white-space: nowrap;
}

/* ── CONNECTING SVG LINES ── */
svg.flow-lines {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none; overflow: visible;
}

/* ── PARALLEL BAND ── */
.par-band {
  width: 88%;
  border: 1.5px dashed #7c3aed;
  border-radius: 4px;
  padding: 8px;
  background: rgba(167,139,250,0.04);
  position: relative;
}
.par-label {
  position: absolute; top: -9px; left: 8px;
  font-size: 8px; font-family: 'Source Code Pro', monospace;
  font-weight: 700; letter-spacing: 0.1em;
  background: var(--white); color: #7c3aed;
  padding: 0 5px; border: 1px solid #7c3aed;
  border-radius: 2px;
}
.par-items { display: flex; flex-direction: column; gap: 4px; }
.par-item {
  font-size: 9.5px; padding: 4px 6px;
  background: rgba(237,233,254,0.5);
  border: 1px solid #c4b5fd;
  border-radius: 3px; color: #5b21b6; line-height: 1.4;
}

/* ── FOOTNOTE ── */
.footnote {
  margin-top: 20px;
  display: grid; grid-template-columns: 1fr 1fr 1fr;
  gap: 14px;
}
.fn-box {
  background: var(--white);
  border: 1px solid #e2e8f0; border-radius: 4px;
  padding: 12px 14px; font-size: 10.5px; color: var(--muted);
  line-height: 1.6;
}
.fn-title {
  font-family: 'Source Serif 4', serif;
  font-size: 12px; font-weight: 700;
  color: var(--ink); margin-bottom: 5px;
}

.footer-strip {
  margin-top: 20px;
  padding-top: 12px; border-top: 1px solid #cbd5e1;
  display: flex; justify-content: space-between;
  font-family: 'Source Code Pro', monospace;
  font-size: 8.5px; color: var(--muted); letter-spacing: 0.06em;
}

/* ── SMALL HELPER ELEMENTS ── */
.dot-connector {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--str-arrow); flex-shrink: 0;
}
.empty-cell { opacity: 0; }

/* Manual action star badge */
.manual-badge {
  display: inline-flex; align-items: center; gap: 3px;
  font-size: 8px; font-weight: 700;
  padding: 2px 6px; border-radius: 20px;
  background: #fef3c7; border: 1px solid #d97706; color: #92400e;
  font-family: 'Source Code Pro', monospace;
  letter-spacing: 0.06em; margin-top: 3px;
  text-transform: uppercase;
}
</style>
</head>
<body>
<div class="page">

<!-- ── DOCUMENT HEADER ── -->
<div class="doc-header">
  <div class="doc-title-block">
    <div class="doc-eyebrow">UML Activity Diagram · Business-Technical Specification</div>
    <div class="doc-title">Genie Bot AI Support Copilot — Workflow</div>
    <div class="doc-sub">Agentic AI · Manual User Rerun · Human-in-the-Loop · Jira Automation · CIB Middle Office</div>
  </div>
  <div class="doc-meta">
    Document Type: UML Activity / Swimlane<br/>
    Audience: Business &amp; Technical Management<br/>
    Version: 2.1 · May 2026<br/>
    Status: AI Governance Forum Submission<br/>
    Classification: CONFIDENTIAL
  </div>
</div>

<!-- ── LEGEND ── -->
<div class="legend-bar">
  <div class="leg">
    <svg class="leg-shape" width="22" height="16"><rect x="1" y="2" width="20" height="12" rx="2" fill="#dbeafe" stroke="#1e40af" stroke-width="1.5"/></svg>
    End User Action
  </div>
  <div class="leg">
    <svg class="leg-shape" width="22" height="16"><rect x="1" y="2" width="20" height="12" rx="2" fill="#ede9fe" stroke="#6d28d9" stroke-width="1.5"/></svg>
    AI Agent Process
  </div>
  <div class="leg">
    <svg class="leg-shape" width="22" height="16"><rect x="1" y="2" width="20" height="12" rx="11" fill="#d1fae5" stroke="#059669" stroke-width="2"/></svg>
    HITL Decision Gate
  </div>
  <div class="leg">
    <svg class="leg-shape" width="16" height="16"><polygon points="8,1 15,8 8,15 1,8" fill="#fde68a" stroke="#d97706" stroke-width="1.5"/></svg>
    Decision / Branch
  </div>
  <div class="leg">
    <svg class="leg-shape" width="22" height="16"><rect x="1" y="2" width="20" height="12" rx="2" fill="#fef3c7" stroke="#b45309" stroke-width="1.5"/></svg>
    Jira / System Action
  </div>
  <div class="leg">
    <svg class="leg-shape" width="22" height="16">
      <polygon points="4,2 18,2 22,8 18,14 4,14 0,8" fill="#f0f9ff" stroke="#0369a1" stroke-width="1.5"/>
    </svg>
    Data / Input / Output
  </div>
  <div class="leg">
    <svg class="leg-shape" width="20" height="8"><rect x="0" y="1" width="20" height="6" rx="2" fill="#6d28d9"/></svg>
    Parallel Fork / Join
  </div>
  <div class="leg">
    <div class="manual-badge">★ Manual</div>
    User performs manually
  </div>
</div>

<!-- ── SWIMLANE DIAGRAM ── -->
<div class="diagram">
<div class="swim-table">

  <!-- LANE HEADERS -->
  <div class="lane-headers">
    <div class="lane-hdr lane-hdr-step" style="font-size:8px;letter-spacing:0.05em">STEP</div>
    <div class="lane-hdr lane-hdr-user">👤 End User<br/><span style="font-size:8px;font-weight:400;opacity:0.85">Business Ops (Non-IT)</span></div>
    <div class="lane-hdr lane-hdr-ai">🤖 AI Agents<br/><span style="font-size:8px;font-weight:400;opacity:0.85">GPT-4.1 · FAISS · RAG</span></div>
    <div class="lane-hdr lane-hdr-hitl">✋ HITL Gates<br/><span style="font-size:8px;font-weight:400;opacity:0.85">Human Control Points</span></div>
    <div class="lane-hdr lane-hdr-jira">🎫 Jira System<br/><span style="font-size:8px;font-weight:400;opacity:0.85">REST API · Auto-Ticket</span></div>
    <div class="lane-hdr lane-hdr-sys" style="background:#374151">☁ External Systems<br/><span style="font-size:8px;font-weight:400;opacity:0.85">S3 · Vector DB · Azure AI</span></div>
  </div>

  <!-- ══════════ START ══════════ -->
  <div class="swim-row row-sm">
    <div class="step-cell">START</div>
    <div class="lane-cell lc-user" style="justify-content:center">
      <div class="node-oval oval-start">START</div>
      <div style="margin-top:6px;font-size:9.5px;color:var(--muted);text-align:center">Genie Bot<br/>encounters error</div>
    </div>
    <div class="lane-cell lc-ai"></div>
    <div class="lane-cell lc-hitl"></div>
    <div class="lane-cell lc-jira"></div>
    <div class="lane-cell lc-sys"></div>
  </div>

  <!-- section divider -->
  <div class="swim-row row-sm" style="border-bottom:none">
    <div class="step-cell"></div>
    <div class="lane-cell lc-user span-all" style="background:#f8fafc;grid-column:2/-1;padding:4px 14px;border-right:none">
      <div style="font-family:'Source Code Pro',monospace;font-size:8.5px;letter-spacing:0.15em;color:#94a3b8;text-transform:uppercase">◈ Phase 1 — Trigger &amp; Entry</div>
    </div>
  </div>

  <!-- ROW 1: User clicks diagnose -->
  <div class="swim-row row-md">
    <div class="step-cell">1</div>
    <div class="lane-cell lc-user">
      <div class="node-rect nr-user">
        <div class="node-name">Click "Diagnose Issue"</div>
        <div class="node-detail">User sees error screen.<br/>Enters: Run ID, User ID, PC name.<br/>Clicks Diagnose button.</div>
        <div class="manual-badge" style="display:inline-flex">★ User Action</div>
      </div>
    </div>
    <div class="lane-cell lc-ai">
      <div class="node-rect nr-ai" style="font-size:10px">
        <div class="node-name" style="font-size:10.5px">Session Created</div>
        <div class="node-detail">FastAPI: POST /workflow/start<br/>Session ID generated<br/>WebSocket opened<br/>YAML config loaded</div>
      </div>
    </div>
    <div class="lane-cell lc-hitl"></div>
    <div class="lane-cell lc-jira"></div>
    <div class="lane-cell lc-sys"></div>
  </div>

  <!-- section divider -->
  <div class="swim-row row-sm" style="border-bottom:none">
    <div class="step-cell"></div>
    <div class="lane-cell lc-user span-all" style="background:#f8fafc;grid-column:2/-1;padding:4px 14px;border-right:none">
      <div style="font-family:'Source Code Pro',monospace;font-size:8.5px;letter-spacing:0.15em;color:#94a3b8;text-transform:uppercase">◈ Phase 2 — Parallel Context Collection (Agent 1)</div>
    </div>
  </div>

  <!-- ROW 2: Parallel context collection -->
  <div class="swim-row row-xl">
    <div class="step-cell">2</div>
    <div class="lane-cell lc-user">
      <div style="text-align:center;font-size:9.5px;color:var(--muted)">Waiting…<br/>Progress shown<br/>via WebSocket</div>
    </div>
    <div class="lane-cell lc-ai">
      <div class="par-band" style="width:95%">
        <div class="par-label">«parallel» asyncio.gather()</div>
        <div class="par-items" style="margin-top:8px">
          <div class="par-item">🔒 <strong>Masking Layer</strong> — PII &amp; financial ID redaction applied to all data first</div>
          <div class="par-item">☁ <strong>S3 Log Fetch</strong> — Retrieves execution log by run_id. Extracts: error_code, module, stack_trace.</div>
          <div class="par-item">🎫 <strong>Jira Search</strong> — JQL query: open GBOT tickets matching error_hash.</div>
          <div class="par-item">🔍 <strong>FAISS Search</strong> — text-embedding-3-small. Top-5 similar past incidents by cosine similarity.</div>
        </div>
      </div>
    </div>
    <div class="lane-cell lc-hitl"></div>
    <div class="lane-cell lc-jira"></div>
    <div class="lane-cell lc-sys">
      <div class="node-rect nr-sys" style="font-size:9.5px;margin-bottom:6px">
        <div class="node-name" style="font-size:10px">AWS S3 Bucket</div>
        <div class="node-detail">Read-only IAM role<br/>prod/genie/{date}/{run_id}.log</div>
      </div>
      <div class="node-rect nr-sys" style="font-size:9.5px;margin-bottom:6px">
        <div class="node-name" style="font-size:10px">FAISS Vector DB</div>
