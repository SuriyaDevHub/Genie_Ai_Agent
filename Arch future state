<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Automation Platform — Current vs Future Flow</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A101C;
    --panel:#101A2C;
    --panel-2:#0D1626;
    --grid:#1B2A44;
    --line:#2C4066;
    --text:#E8EDF6;
    --text-dim:#8493AC;
    --blue:#4C86D6;
    --blue-soft: rgba(76,134,214,0.18);
    --amber:#E3A73C;
    --amber-soft: rgba(227,167,60,0.18);
    --green:#3FBF7F;
    --green-soft: rgba(63,191,127,0.18);
    --red:#E2574C;
    --red-soft: rgba(226,87,76,0.16);
    --tactical:#5B6B8C;
    --userA:#4C86D6;
    --userA-soft: rgba(76,134,214,0.18);
    --userB:#9B7FD4;
    --userB-soft: rgba(155,127,212,0.18);
    --userC:#22B8B0;
    --userC-soft: rgba(34,184,176,0.18);
    --owned:#2FBF9A;
    --owned-soft: rgba(47,191,154,0.16);
    --partner:#8B9BC2;
    --partner-soft: rgba(139,155,194,0.14);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(circle at 15% 0%, rgba(76,134,214,0.08), transparent 40%),
      radial-gradient(circle at 85% 100%, rgba(227,167,60,0.06), transparent 45%),
      var(--bg);
    color:var(--text);
    font-family:'IBM Plex Mono', monospace;
    min-height:100vh;
    padding:28px 18px 60px;
  }
  .wrap{ max-width:1000px; margin:0 auto; }
  .accent-bar{
    height:3px; width:210px; margin:0 auto 20px; border-radius:3px;
    background:linear-gradient(90deg, var(--blue), var(--owned));
    opacity:.85;
  }

  header{ text-align:center; margin-bottom:22px; }
  .eyebrow{
    font-size:11px; letter-spacing:.28em; text-transform:uppercase;
    color:var(--text-dim); margin-bottom:10px;
  }
  .scale-badges{
    display:flex; justify-content:center; gap:10px; flex-wrap:wrap;
    margin:4px 0 18px;
  }
  .scale-badges span{
    font-size:11px; color:var(--text-dim);
    border:1px solid var(--grid);
    background:rgba(255,255,255,0.02);
    border-radius:999px;
    padding:5px 13px;
    display:inline-flex; align-items:center; gap:6px;
  }
  .scale-badges .n{ color:var(--blue); font-weight:600; font-family:'Space Grotesk',sans-serif; }
  .scale-badges .owned-badge{
    border-color:rgba(47,191,154,.4);
    background:var(--owned-soft);
    color:#BFEEDF;
  }
  .scale-badges .owned-badge .n{ color:var(--owned); }
  h1{
    font-family:'Space Grotesk', sans-serif;
    font-weight:700;
    font-size:clamp(22px,4vw,32px);
    margin:0 0 8px;
    letter-spacing:-0.01em;
  }
  .sub{
    color:var(--text-dim);
    font-size:14px;
    max-width:620px;
    margin:0 auto 22px;
    line-height:1.5;
    min-height:22px;
    transition:opacity .3s ease;
  }

  /* toggle */
  .toggle{
    display:inline-flex;
    flex-wrap:wrap;
    justify-content:center;
    background:var(--panel-2);
    border:1px solid var(--grid);
    border-radius:999px;
    padding:4px;
    gap:4px;
    margin:0 auto 8px;
  }
  .toggle button{
    font-family:'Space Grotesk',sans-serif;
    font-weight:600;
    font-size:13px;
    letter-spacing:.02em;
    border:none;
    background:transparent;
    color:var(--text-dim);
    padding:9px 20px;
    border-radius:999px;
    cursor:pointer;
    transition:all .25s ease;
  }
  .toggle button:hover:not(.on){
    background:rgba(255,255,255,0.05);
    color:var(--text);
  }
  .toggle button:focus-visible{
    outline:2px solid var(--blue);
    outline-offset:2px;
  }
  .toggle button.on{
    background:linear-gradient(135deg,var(--blue),#3467AE);
    color:#fff;
    box-shadow:0 4px 14px rgba(76,134,214,.35);
  }
  .toggle-row{ display:flex; justify-content:center; margin-bottom:6px;}

  /* readout strip */
  .readouts{
    display:flex; justify-content:center; gap:26px;
    margin:16px auto 24px; flex-wrap:wrap;
  }
  .readout{ text-align:center; min-width:92px; }
  .readout .val{
    font-family:'Space Grotesk',sans-serif;
    font-size:20px; font-weight:700; color:var(--text);
    transition:color .3s ease;
  }
  .readout .lbl{
    font-size:10px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--text-dim); margin-top:2px;
  }
  .readout.dim .val{ color:var(--tactical); }

  /* stage */
  .stage-outer{
    position:relative;
    width:100%;
    max-width:760px;
    margin:0 auto;
    border-radius:16px;
    background:linear-gradient(180deg, var(--panel), var(--panel-2));
    border:1px solid var(--grid);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.03), 0 20px 50px rgba(0,0,0,.35);
    overflow:hidden;
  }
  .stage-outer.current{ aspect-ratio: 1000 / 760; }
  .stage-outer.future{ aspect-ratio: 1000 / 900; }
  .stage-outer.walkthrough{ aspect-ratio: 1000 / 1000; }
  .hidden{ display:none !important; }

  .stage-inner{
    position:absolute; top:0; left:0;
    transform-origin: top left;
  }
  .stage-inner.current{ width:1000px; height:760px; }
  .stage-inner.future{ width:1000px; height:900px; }
  .stage-inner.walkthrough{ width:1000px; height:1000px; }

  .connector-svg{ position:absolute; top:0; left:0; width:100%; height:100%; }
  .connector-svg path.line{
    fill:none; stroke:var(--line); stroke-width:2.5;
  }
  .connector-svg path.feedback{
    fill:none; stroke:var(--amber); stroke-width:2.25; stroke-dasharray:6 7; opacity:.65;
  }

  .node{
    position:absolute;
    transform:translate(-50%,-50%);
    border:1px solid var(--grid);
    background:rgba(16,26,44,.9);
    border-radius:10px;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center;
    padding:6px 10px;
    transition: box-shadow .25s ease, border-color .25s ease, background .25s ease;
  }
  .node .t{
    font-family:'Space Grotesk',sans-serif;
    font-weight:600; font-size:13.5px; color:var(--text);
  }
  .node .s{
    font-size:10px; color:var(--text-dim); margin-top:2px; letter-spacing:.02em;
  }
  .node.end{ border-color:#33456C; background:rgba(20,30,50,.95); }
  .node.ai{ border-color:#4A3E22; background:rgba(40,32,14,.55); }
  .node.active{
    border-color:var(--blue);
    box-shadow:0 0 0 4px var(--blue-soft), 0 0 18px rgba(76,134,214,.4);
  }
  .node.active.success{
    border-color:var(--green);
    box-shadow:0 0 0 4px var(--green-soft), 0 0 18px rgba(63,191,127,.4);
  }
  .node.active.fail{
    border-color:var(--red);
    box-shadow:0 0 0 4px var(--red-soft), 0 0 18px rgba(226,87,76,.4);
  }
  .node.active.thinking{
    border-color:var(--amber);
    box-shadow:0 0 0 4px var(--amber-soft), 0 0 18px rgba(227,167,60,.4);
  }

  .packet{
    position:absolute; top:0; left:0;
    width:13px; height:13px;
    border-radius:50%;
    background:var(--blue);
    box-shadow:0 0 10px 3px rgba(76,134,214,.7);
    opacity:0;
    transform:translate(-50%,-50%);
  }
  .packet.success{ background:var(--green); box-shadow:0 0 10px 3px rgba(63,191,127,.7); }
  .packet.fail{ background:var(--red); box-shadow:0 0 10px 3px rgba(226,87,76,.7); }
  .packet.retry{ background:var(--amber); box-shadow:0 0 10px 3px rgba(227,167,60,.7); }

  .ghost{
    position:absolute; transform:translate(-50%,-50%);
    width:30px; height:30px; border-radius:50%;
    border:1.5px dashed var(--tactical);
    display:flex; align-items:center; justify-content:center;
    font-family:'Space Grotesk',sans-serif; font-size:14px; font-weight:700;
    color:var(--tactical);
    opacity:0;
  }
  .ghost.show{ animation: ghostFlash 1.4s ease; }
  @keyframes ghostFlash{
    0%{opacity:0; transform:translate(-50%,-50%) scale(.7);}
    18%{opacity:1; transform:translate(-50%,-50%) scale(1);}
    70%{opacity:1;}
    100%{opacity:0;}
  }

  .caption{
    position:absolute;
    font-size:10px; color:var(--text-dim); letter-spacing:.04em;
  }

  .legend{
    display:flex; justify-content:center; flex-wrap:wrap; gap:16px;
    margin-top:18px; font-size:11px; color:var(--text-dim);
  }
  .legend span{ display:inline-flex; align-items:center; gap:6px; }
  .dot{ width:9px; height:9px; border-radius:50%; display:inline-block; }

  .readouts.hidden{ display:none !important; }

  .node.local{ border-color:#4A5A7C; background:rgba(24,32,50,.85); }
  .node.local .t{ color:#C7CFE0; }
  .node.platform{ border-color:var(--blue); background:rgba(20,32,54,.9); }

  .node.owned{ border-color:var(--owned); background:rgba(20,42,38,.6); }
  .node.owned .s{ color:#8FD9C4; }
  .node.partner{ border-color:var(--partner); background:rgba(26,30,42,.6); }
  .node.partner .s{ color:#B7C0DE; }
  .node.active.owned{ box-shadow:0 0 0 4px var(--owned-soft), 0 0 18px rgba(47,191,154,.4); }
  .node.active.partner{ box-shadow:0 0 0 4px var(--partner-soft), 0 0 18px rgba(139,155,194,.4); }

  .col-heading{
    position:absolute;
    font-family:'Space Grotesk',sans-serif;
    font-size:12.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase;
    transform:translate(-50%,-50%);
  }
  .col-heading.local{ color:var(--tactical); }
  .col-heading.platform{ color:var(--blue); }

  .step-caption{
    max-width:700px; margin:14px auto 0;
    text-align:center; font-size:13px; line-height:1.5;
    color:var(--text); min-height:40px;
    padding:0 12px;
  }
  .step-caption b{ color:var(--blue); }

  /* multi-user walkthrough */
  .step-dots{
    display:flex; justify-content:center; gap:7px; margin:2px 0 4px;
  }
  .step-dots i{
    width:7px; height:7px; border-radius:50%;
    background:var(--grid); display:inline-block;
    transition:background .3s ease, transform .3s ease;
  }
  .step-dots i.on{ background:var(--blue); transform:scale(1.3); }

  .avatar{
    position:absolute; transform:translate(-50%,-50%);
    width:62px; height:62px; border-radius:50%;
    border:2px solid var(--grid);
    display:flex; align-items:center; justify-content:center;
    flex-direction:column;
    font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:15px;
    background:rgba(16,26,44,.9);
    transition: box-shadow .25s ease, border-color .25s ease;
  }
  .avatar .role{
    font-family:'IBM Plex Mono',monospace; font-weight:400; font-size:8px;
    color:var(--text-dim); margin-top:1px; letter-spacing:.02em;
  }
  .avatar.userA{ color:var(--userA); }
  .avatar.userB{ color:var(--userB); }
  .avatar.userC{ color:var(--userC); }
  .avatar.active.userA{ border-color:var(--userA); box-shadow:0 0 0 5px var(--userA-soft), 0 0 16px rgba(76,134,214,.45); }
  .avatar.active.userB{ border-color:var(--userB); box-shadow:0 0 0 5px var(--userB-soft), 0 0 16px rgba(155,127,212,.45); }
  .avatar.active.userC{ border-color:var(--userC); box-shadow:0 0 0 5px var(--userC-soft), 0 0 16px rgba(34,184,176,.45); }

  .node.active.userA{ border-color:var(--userA); box-shadow:0 0 0 4px var(--userA-soft), 0 0 18px rgba(76,134,214,.4); }
  .node.active.userB{ border-color:var(--userB); box-shadow:0 0 0 4px var(--userB-soft), 0 0 18px rgba(155,127,212,.4); }
  .node.active.userC{ border-color:var(--userC); box-shadow:0 0 0 4px var(--userC-soft), 0 0 18px rgba(34,184,176,.4); }

  .packet.userA{ background:var(--userA); box-shadow:0 0 10px 3px rgba(76,134,214,.7); }
  .packet.userB{ background:var(--userB); box-shadow:0 0 10px 3px rgba(155,127,212,.7); }
  .packet.userC{ background:var(--userC); box-shadow:0 0 10px 3px rgba(34,184,176,.7); }
  .packet.cicd{ width:9px; height:9px; background:var(--amber); box-shadow:0 0 8px 2px rgba(227,167,60,.6); opacity:.55; }

  .pending-badge{
    position:absolute; transform:translate(-50%,-50%);
    font-size:9px; color:var(--amber);
    background:rgba(227,167,60,.12);
    border:1px solid var(--amber);
    border-radius:999px; padding:2px 8px;
    opacity:0; white-space:nowrap;
  }
  .pending-badge.show{ animation:pendingFlash 1.9s ease; }
  @keyframes pendingFlash{
    0%{opacity:0;} 15%{opacity:1;} 80%{opacity:1;} 100%{opacity:0;}
  }

  footer{
    text-align:center; margin-top:26px; font-size:11px; color:var(--text-dim);
  }

  @media (max-width: 480px){
    .toggle button{ padding:8px 13px; font-size:12px; }
  }
  @media (prefers-reduced-motion: reduce){
    .packet{ transition:none !important; }
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="accent-bar"></div>

  <header>
    <div class="eyebrow">CIB Middle Office · Genie Bot Automation Platform</div>
    <h1>How the Automation Flow Works</h1>
    <div class="scale-badges">
      <span><span class="n">~250</span>&nbsp;bots in scope</span>
      <span>codebase already in <span class="n">GitHub</span></span>
      <span><span class="n">multi-user</span>&nbsp;concurrent execution</span>
      <span class="owned-badge">owned &amp; run by <span class="n">our team</span></span>
    </div>
    <div class="toggle-row">
      <div class="toggle" role="tablist" aria-label="Select state">
        <button id="btn-current" class="on" role="tab" aria-selected="true">Current State</button>
        <button id="btn-future" role="tab" aria-selected="false">Future State</button>
        <button id="btn-migration" role="tab" aria-selected="false">What Moves Where</button>
        <button id="btn-walkthrough" role="tab" aria-selected="false">Multi-User Walkthrough</button>
        <button id="btn-ownership" role="tab" aria-selected="false">Ownership &amp; Rollout</button>
      </div>
    </div>
    <p class="sub" id="subline">One bot, one desktop — a job runs, and once it reaches the internal application, nobody downstream can see whether it actually worked.</p>
  </header>

  <div class="readouts" id="readouts">
    <div class="readout dim"><div class="val" id="r1">--</div><div class="lbl">Queue depth</div></div>
    <div class="readout dim"><div class="val" id="r2">--</div><div class="lbl">Success rate</div></div>
    <div class="readout dim"><div class="val" id="r3">--</div><div class="lbl">Auto-recovered</div></div>
  </div>

  <!-- CURRENT STATE -->
  <div class="stage-outer current" id="scene-current">
    <div class="stage-inner current" id="inner-current">
      <svg class="connector-svg" viewBox="0 0 1000 760" id="svg-current"></svg>
      <!-- nodes -->
      <div class="node" style="left:50%;top:7.9%;width:220px;height:56px;" id="cur-user"><div class="t">User</div><div class="s">1 of many, own desktop</div></div>
      <div class="node" style="left:50%;top:25%;width:220px;height:56px;" id="cur-wrapper"><div class="t">Genie Bot</div><div class="s">picks automation</div></div>
      <div class="node" style="left:50%;top:42.1%;width:220px;height:56px;" id="cur-select"><div class="t">Select Automation</div><div class="s">1 of ~250 bots</div></div>
      <div class="node" style="left:50%;top:59.2%;width:220px;height:56px;" id="cur-launch"><div class="t">Launch Local EXE</div><div class="s">built by hand from GitHub</div></div>
      <div class="node" style="left:50%;top:76.3%;width:220px;height:56px;" id="cur-bot"><div class="t">Genie Bot Engine</div></div>
      <div class="node end" style="left:50%;top:92.1%;width:260px;height:56px;" id="cur-apps"><div class="t">Internal Application</div></div>
      <div class="ghost" style="left:78%;top:92.1%;" id="cur-ghost">?</div>
      <div class="caption" style="left:78%;top:97%;transform:translate(-50%,0);">no status logged</div>
    </div>
  </div>

  <!-- FUTURE STATE -->
  <div class="stage-outer future hidden" id="scene-future">
    <div class="stage-inner future" id="inner-future">
      <svg class="connector-svg" viewBox="0 0 1000 900" id="svg-future"></svg>
      <div class="node" style="left:50%;top:5.6%;width:230px;height:56px;" id="fut-portal"><div class="t">Self-Service Portal</div></div>
      <div class="node" style="left:50%;top:15.6%;width:230px;height:56px;" id="fut-auth"><div class="t">Auth &amp; RBAC</div><div class="s">AD / SSO</div></div>
      <div class="node" style="left:50%;top:25.6%;width:230px;height:56px;" id="fut-orch"><div class="t">Genie Bot Orchestrator</div><div class="s">.NET</div></div>
      <div class="node" style="left:50%;top:35.6%;width:230px;height:56px;" id="fut-approval"><div class="t">Approval Engine</div><div class="s">maker-checker</div></div>
      <div class="node" style="left:50%;top:45.6%;width:230px;height:56px;" id="fut-queue"><div class="t">Job Queue</div><div class="s">fed by GitHub via CI/CD</div></div>
      <div class="node" style="left:19%;top:57.8%;width:180px;height:56px;" id="fut-w1"><div class="t">Genie Bot · Instrument</div></div>
      <div class="node" style="left:50%;top:57.8%;width:180px;height:56px;" id="fut-w2"><div class="t">Genie Bot · Pricing</div></div>
      <div class="node" style="left:81%;top:57.8%;width:180px;height:56px;" id="fut-w3"><div class="t">Genie Bot · DataOps</div></div>
      <div class="caption" style="left:8%;top:63%;transform:translate(-50%,0);width:150px;text-align:center;">auto-scaling pool · many users, at once</div>
      <div class="node end" style="left:50%;top:70%;width:440px;height:60px;" id="fut-apps"><div class="t">Internal Applications</div></div>
      <div class="node ai" style="left:50%;top:82.2%;width:440px;height:60px;" id="fut-ai"><div class="t">Logs · Audit · AI Ops Layer</div><div class="s" id="fut-ai-sub">watching every job</div></div>
      <div class="caption" style="left:93%;top:64%;transform:translate(-50%,0);">auto&#8209;retry</div>
    </div>
  </div>

  <!-- MIGRATION MAP -->
  <div class="stage-outer current hidden" id="scene-migration">
    <div class="stage-inner current" id="inner-migration">
      <svg class="connector-svg" viewBox="0 0 1000 760" id="svg-migration"></svg>

      <div class="col-heading local" style="left:22%;top:5.3%;">Today · on the desktop</div>
      <div class="col-heading platform" style="left:78%;top:5.3%;">Tomorrow · on the platform</div>

      <div class="node local" style="left:22%;top:14.5%;width:280px;height:60px;" id="mig-l1"><div class="t">Genie Bot Wrapper</div><div class="s">picks &amp; launches automation</div></div>
      <div class="node local" style="left:22%;top:39.5%;width:280px;height:60px;" id="mig-l2"><div class="t">Manual Selection</div><div class="s">user chooses which EXE to run</div></div>
      <div class="node local" style="left:22%;top:64.5%;width:280px;height:60px;" id="mig-l3"><div class="t">Local EXE</div><div class="s">built by hand from GitHub, copied PC-by-PC</div></div>
      <div class="node local" style="left:22%;top:89.5%;width:280px;height:60px;" id="mig-l4"><div class="t">Genie Bot Engine</div><div class="s">one user, one job, one desktop at a time</div></div>

      <div class="node platform" style="left:78%;top:14.5%;width:290px;height:60px;" id="mig-r1"><div class="t">Genie Bot Orchestrator</div><div class="s">assigns work, tracks execution</div></div>
      <div class="node platform" style="left:78%;top:39.5%;width:290px;height:60px;" id="mig-r2"><div class="t">Portal + Approval Engine</div><div class="s">governed request, maker-checker</div></div>
      <div class="node platform" style="left:78%;top:64.5%;width:290px;height:60px;" id="mig-r3"><div class="t">CI/CD + Artifact Registry</div><div class="s">builds the same GitHub repo, versions it</div></div>
      <div class="node platform" style="left:78%;top:89.5%;width:290px;height:60px;" id="mig-r4"><div class="t">Auto-Scaling Worker Pool</div><div class="s">many users, many jobs, at once</div></div>
    </div>
  </div>
  <p class="step-caption hidden" id="mig-caption">&nbsp;</p>

  <!-- MULTI-USER WALKTHROUGH -->
  <div class="stage-outer walkthrough hidden" id="scene-walkthrough">
    <div class="stage-inner walkthrough" id="inner-walkthrough">
      <svg class="connector-svg" viewBox="0 0 1000 1000" id="svg-walkthrough"></svg>

      <div class="avatar userA" style="left:26%;top:4.5%;" id="wk-userA">A<span class="role">Pricing</span></div>
      <div class="avatar userB" style="left:50%;top:4.5%;" id="wk-userB">B<span class="role">Static Data</span></div>
      <div class="avatar userC" style="left:74%;top:4.5%;" id="wk-userC">C<span class="role">DataOps</span></div>

      <div class="node" style="left:50%;top:15%;width:260px;height:56px;" id="wk-portal"><div class="t">Self-Service Portal</div></div>
      <div class="node" style="left:50%;top:23%;width:260px;height:56px;" id="wk-auth"><div class="t">Auth &amp; RBAC</div><div class="s">AD / SSO</div></div>
      <div class="node" style="left:50%;top:31%;width:260px;height:56px;" id="wk-orch"><div class="t">Genie Bot Orchestrator</div></div>
