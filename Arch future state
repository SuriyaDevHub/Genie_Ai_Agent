<script>
(function(){
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const delay = ms => new Promise(res => setTimeout(res, ms));

  // ---------- responsive scaling ----------
  function fit(outerId, innerId){
    const outer = document.getElementById(outerId);
    const inner = document.getElementById(innerId);
    const baseW = inner.classList.contains('current') ? 1000 : 1000;
    function resize(){
      const w = outer.getBoundingClientRect().width;
      const scale = w / baseW;
      inner.style.transform = 'scale(' + scale + ')';
    }
    new ResizeObserver(resize).observe(outer);
    resize();
  }
  fit('scene-current','inner-current');
  fit('scene-future','inner-future');
  fit('scene-migration','inner-migration');
  fit('scene-walkthrough','inner-walkthrough');
  fit('scene-ownership','inner-ownership');

  // ---------- draw connector paths ----------
  function drawPaths(svgId, defs){
    const svg = document.getElementById(svgId);
    defs.forEach(function(d){
      const p = document.createElementNS('http://www.w3.org/2000/svg','path');
      p.setAttribute('d', d.d);
      p.setAttribute('class', d.cls || 'line');
      svg.appendChild(p);
    });
  }

  // ===================================================================
  // CURRENT STATE PATHS
  // ===================================================================
  const curPaths = {
    e1:'M500,88 L500,162',
    e2:'M500,218 L500,292',
    e3:'M500,348 L500,422',
    e4:'M500,478 L500,552',
    e5:'M500,608 L500,672'
  };
  drawPaths('svg-current', [
    {d:curPaths.e1},{d:curPaths.e2},{d:curPaths.e3},{d:curPaths.e4},{d:curPaths.e5}
  ]);

  // ===================================================================
  // FUTURE STATE PATHS
  // ===================================================================
  const futPaths = {
    e1:'M500,84 L500,116',                              // portal -> auth
    e2:'M500,172 L500,204',                              // auth -> orchestrator
    e3:'M500,260 L500,292',                              // orchestrator -> approval
    e4:'M500,348 L500,380',                              // approval -> queue
    e5:'M440,436 Q 300,470 190,492',                      // queue -> w1
    e6:'M500,436 L500,492',                               // queue -> w2
    e7:'M560,436 Q 700,470 810,492',                      // queue -> w3
    e8:'M190,548 Q 260,585 350,596',                       // w1 -> apps
    e9:'M500,548 L500,596',                               // w2 -> apps
    e10:'M810,548 Q 740,585 650,596',                      // w3 -> apps
    e11:'M500,658 L500,696',                              // apps -> ai
    feedback:'M726,733 C 950,733 950,410 620,410'          // ai -> queue (retry loop)
  };
  drawPaths('svg-future', [
    {d:futPaths.e1},{d:futPaths.e2},{d:futPaths.e3},{d:futPaths.e4},
    {d:futPaths.e5},{d:futPaths.e6},{d:futPaths.e7},
    {d:futPaths.e8},{d:futPaths.e9},{d:futPaths.e10},
    {d:futPaths.e11},
    {d:futPaths.feedback, cls:'feedback'}
  ]);

  // ===================================================================
  // MIGRATION MAP PATHS (local component -> platform replacement)
  // ===================================================================
  const migPaths = {
    r1:'M360,110 L635,110',
    r2:'M360,300 L635,300',
    r3:'M360,490 L635,490',
    r4:'M360,680 L635,680'
  };
  drawPaths('svg-migration', [
    {d:migPaths.r1},{d:migPaths.r2},{d:migPaths.r3},{d:migPaths.r4}
  ]);

  // ===================================================================
  // MULTI-USER WALKTHROUGH PATHS
  // ===================================================================
  const wkPaths = {
    userAToPortal:'M260,76 Q 340,100 430,122',
    userBToPortal:'M500,76 L500,122',
    userCToPortal:'M740,76 Q 660,100 570,122',
    portalToAuth:'M500,178 L500,202',
    authToOrch:'M500,258 L500,282',
    orchToApproval:'M500,338 L500,362',
    approvalToCicd:'M500,418 L500,442',
    cicdToQueue:'M500,498 L500,522',
    queueToW1:'M440,578 Q 300,600 190,602',
    queueToW2:'M500,578 L500,602',
    queueToW3:'M560,578 Q 700,600 810,602',
    w1ToApps:'M190,658 Q 260,680 350,680',
    w2ToApps:'M500,658 L500,680',
    w3ToApps:'M810,658 Q 740,680 650,680',
    appsToAi:'M500,740 L500,760',
    aiToPortal:'M720,790 C 950,790 950,150 630,150'
  };
  drawPaths('svg-walkthrough', [
    {d:wkPaths.userAToPortal},{d:wkPaths.userBToPortal},{d:wkPaths.userCToPortal},
    {d:wkPaths.portalToAuth},{d:wkPaths.authToOrch},{d:wkPaths.orchToApproval},
    {d:wkPaths.approvalToCicd},{d:wkPaths.cicdToQueue},
    {d:wkPaths.queueToW1},{d:wkPaths.queueToW2},{d:wkPaths.queueToW3},
    {d:wkPaths.w1ToApps},{d:wkPaths.w2ToApps},{d:wkPaths.w3ToApps},
    {d:wkPaths.appsToAi},
    {d:wkPaths.aiToPortal, cls:'feedback'}
  ]);

  // ===================================================================
  // OWNERSHIP & ROLLOUT PATHS
  // ===================================================================
  const ownPaths = {
    portalToAuth:'M500,120 L500,150',
    authToOrch:'M500,210 L500,240',
    orchToApproval:'M500,300 L500,330',
    approvalToCicd:'M500,390 L500,420',
    cicdToQueue:'M500,480 L500,510',
    queueToWorkers:'M500,570 L500,600',
    workersToApps:'M500,660 L500,690',
    appsToAi:'M500,750 L500,780'
  };
  drawPaths('svg-ownership', [
    {d:ownPaths.portalToAuth},{d:ownPaths.authToOrch},{d:ownPaths.orchToApproval},
    {d:ownPaths.approvalToCicd},{d:ownPaths.cicdToQueue},{d:ownPaths.queueToWorkers},
    {d:ownPaths.workersToApps},{d:ownPaths.appsToAi}
  ]);

  // ---------- helpers ----------
  function pulse(node, cls, dur){
    if(!node) return;
    node.classList.add('active');
    if(cls) node.classList.add(cls);
    setTimeout(function(){
      node.classList.remove('active');
      if(cls) node.classList.remove(cls);
    }, dur || 700);
  }

  function makePacket(container, colorCls){
    const p = document.createElement('div');
    p.className = 'packet' + (colorCls ? ' ' + colorCls : '');
    container.appendChild(p);
    return p;
  }

  function travel(packet, d, duration){
    return new Promise(function(resolve){
      if(reduceMotion){ packet.remove(); resolve(); return; }
      packet.style.offsetPath = "path('" + d + "')";
      packet.style.offsetDistance = '0%';
      packet.style.opacity = '1';
      const anim = packet.animate(
        [{ offsetDistance:'0%' }, { offsetDistance:'100%' }],
        { duration: duration, easing:'ease-in-out', fill:'forwards' }
      );
      anim.onfinish = function(){ resolve(); };
    });
  }

  function fadeOut(packet, dur){
    return new Promise(function(resolve){
      if(reduceMotion){ packet.remove(); resolve(); return; }
      const a = packet.animate([{opacity:1},{opacity:0}], {duration: dur||350, fill:'forwards'});
      a.onfinish = function(){ packet.remove(); resolve(); };
    });
  }

  // ===================================================================
  // CURRENT STATE LOOP
  // ===================================================================
  let token = 0;

  async function runCurrent(myToken){
    const container = document.getElementById('inner-current');
    const nodes = {
      user: document.getElementById('cur-user'),
      wrapper: document.getElementById('cur-wrapper'),
      select: document.getElementById('cur-select'),
      launch: document.getElementById('cur-launch'),
      bot: document.getElementById('cur-bot'),
      apps: document.getElementById('cur-apps')
    };
    const ghost = document.getElementById('cur-ghost');

    while(token === myToken){
      const packet = makePacket(container);
      pulse(nodes.user);
      await travel(packet, curPaths.e1, 850); if(token!==myToken){packet.remove();return;}
      pulse(nodes.wrapper);
      await travel(packet, curPaths.e2, 850); if(token!==myToken){packet.remove();return;}
      pulse(nodes.select);
      await travel(packet, curPaths.e3, 850); if(token!==myToken){packet.remove();return;}
      pulse(nodes.launch);
      await travel(packet, curPaths.e4, 850); if(token!==myToken){packet.remove();return;}
      pulse(nodes.bot);
      await travel(packet, curPaths.e5, 850); if(token!==myToken){packet.remove();return;}
      pulse(nodes.apps, null, 900);
      ghost.classList.remove('show'); void ghost.offsetWidth; ghost.classList.add('show');
      await fadeOut(packet, 350);
      if(token!==myToken) return;
      await delay(1300);
    }
  }

  // ===================================================================
  // FUTURE STATE LOOP
  // ===================================================================
  async function runFuture(myToken){
    const container = document.getElementById('inner-future');
    const N = {
      portal: document.getElementById('fut-portal'),
      auth: document.getElementById('fut-auth'),
      orch: document.getElementById('fut-orch'),
      approval: document.getElementById('fut-approval'),
      queue: document.getElementById('fut-queue'),
      w1: document.getElementById('fut-w1'),
      w2: document.getElementById('fut-w2'),
      w3: document.getElementById('fut-w3'),
      apps: document.getElementById('fut-apps'),
      ai: document.getElementById('fut-ai')
    };
    const aiSub = document.getElementById('fut-ai-sub');
    let queued = 6, success = 92, recovered = 0;
    const r1 = document.getElementById('r1'), r2 = document.getElementById('r2'), r3 = document.getElementById('r3');

    function setReadouts(){
      r1.textContent = queued; r2.textContent = success + '%'; r3.textContent = recovered;
    }

    while(token === myToken){
      // intake: portal -> queue
      const intake = makePacket(container);
      pulse(N.portal);
      await travel(intake, futPaths.e1, 500); if(token!==myToken){intake.remove();return;}
      pulse(N.auth);
      await travel(intake, futPaths.e2, 500); if(token!==myToken){intake.remove();return;}
      pulse(N.orch);
      await travel(intake, futPaths.e3, 500); if(token!==myToken){intake.remove();return;}
      pulse(N.approval);
      await travel(intake, futPaths.e4, 500); if(token!==myToken){intake.remove();return;}
      pulse(N.queue, null, 900);
      await fadeOut(intake, 250);
      if(token!==myToken) return;
      queued = 3; setReadouts();

      // fan-out: queue -> 3 workers in parallel
      const p1 = makePacket(container), p2 = makePacket(container), p3 = makePacket(container);
      pulse(N.w1); pulse(N.w2); pulse(N.w3);
      await Promise.all([
        travel(p1, futPaths.e5, 650),
        travel(p2, futPaths.e6, 650),
        travel(p3, futPaths.e7, 650)
      ]);
      if(token!==myToken){p1.remove();p2.remove();p3.remove();return;}
      queued = 0; setReadouts();

      // workers -> apps (p3 will be the one that fails)
      await Promise.all([
        travel(p1, futPaths.e8, 600),
        travel(p2, futPaths.e9, 600),
        travel(p3, futPaths.e10, 600)
      ]);
      if(token!==myToken){p1.remove();p2.remove();p3.remove();return;}

      pulse(N.apps, 'success', 700);
      p1.classList.add('success'); p2.classList.add('success'); p3.classList.add('fail');
      await delay(250);

      // apps -> ai layer, all three
      await Promise.all([
        travel(p1, futPaths.e11, 500),
        travel(p2, futPaths.e11, 500),
        travel(p3, futPaths.e11, 500)
      ]);
      if(token!==myToken){p1.remove();p2.remove();p3.remove();return;}

      success = 92;
      pulse(N.ai, 'success', 700);
      await Promise.all([fadeOut(p1,250), fadeOut(p2,250)]);
      setReadouts();

      // failed packet lingers, AI "diagnoses"
      p3.style.opacity = '1';
      N.ai.classList.add('active','thinking');
      aiSub.textContent = 'diagnosing failed job…';
      await delay(1100);
      if(token!==myToken){p3.remove();N.ai.classList.remove('active','thinking');return;}
      N.ai.classList.remove('active','thinking');
      aiSub.textContent = 'watching every job';
      await fadeOut(p3, 200);

      // retry loop: ai -> queue -> w3 -> apps -> ai (success, green)
      const retry = makePacket(container, 'retry');
      pulse(N.queue, 'thinking', 900);
      await travel(retry, futPaths.feedback, 900); if(token!==myToken){retry.remove();return;}
      pulse(N.w3);
      retry.classList.remove('retry');
      await travel(retry, futPaths.e7, 550); if(token!==myToken){retry.remove();return;}
      await travel(retry, futPaths.e10, 550); if(token!==myToken){retry.remove();return;}
      retry.classList.add('success');
      pulse(N.apps, 'success', 600);
      await travel(retry, futPaths.e11, 500); if(token!==myToken){retry.remove();return;}
      pulse(N.ai, 'success', 700);
      recovered += 1; success = 100;
      setReadouts();
      await fadeOut(retry, 250);
      if(token!==myToken) return;

      await delay(1400);
    }
  }

  // ===================================================================
  // MIGRATION MAP LOOP
  // ===================================================================
  async function runMigration(myToken){
    const container = document.getElementById('inner-migration');
    const caption = document.getElementById('mig-caption');
    const steps = [
      { L:'mig-l1', R:'mig-r1', path: migPaths.r1,
        text: '<b>Genie Bot\u2019s</b> routing logic moves into the <b>Orchestrator</b> — same tool we own today, the desktop just stops deciding which job runs where.' },
      { L:'mig-l2', R:'mig-r2', path: migPaths.r2,
        text: '<b>Manually picking</b> an automation becomes a governed request through the <b>Portal</b>, gated by maker-checker approval.' },
      { L:'mig-l3', R:'mig-r3', path: migPaths.r3,
        text: 'The <b>Local EXE</b> — built by hand from the existing <b>GitHub</b> source and copied PC-by-PC — is replaced by a <b>CI/CD pipeline</b> that builds the same repo and publishes a versioned artifact automatically. No migration of code, just a pipeline on top of it.' },
      { L:'mig-l4', R:'mig-r4', path: migPaths.r4,
        text: 'The <b>Genie Bot engine</b> that ran one job at a time on one desktop becomes an <b>auto-scaling Worker Pool</b> — the same tool we already own, now able to serve many users running jobs at once.' }
    ];
    const nodes = {};
    steps.forEach(function(s){
      nodes[s.L] = document.getElementById(s.L);
      nodes[s.R] = document.getElementById(s.R);
    });

    while(token === myToken){
      for(let i=0;i<steps.length;i++){
        const s = steps[i];
        caption.innerHTML = s.text;
        pulse(nodes[s.L], null, 1000);
        pulse(nodes[s.R], 'success', 1000);
        const packet = makePacket(container);
        await travel(packet, s.path, 850); if(token!==myToken){packet.remove();return;}
        await fadeOut(packet, 250);
        if(token!==myToken) return;
        await delay(450);
      }
      caption.innerHTML = '<b>End state:</b> no automation logic needs to live on a desktop.';
      await delay(2200);
      if(token!==myToken) return;
    }
  }

  // ===================================================================
  // MULTI-USER WALKTHROUGH LOOP
  // ===================================================================
  const wkStepText = [
    'Users <b>A</b>, <b>B</b>, and <b>C</b> each log into the Self-Service Portal through existing SSO — no separate accounts to manage.',
    'The portal checks each user\u2019s identity and role via <b>RBAC</b> before anything is submitted.',
    'Each request reaches the <b>Genie Bot Orchestrator</b>, which takes ownership of tracking it end-to-end.',
    'The <b>Approval Engine</b> applies maker-checker only where the bot\u2019s action needs it — User B\u2019s request waits for sign-off; A\u2019s and C\u2019s don\u2019t.',
    'In the background, <b>GitHub → CI/CD → Artifact Registry</b> keeps every one of the ~250 bots built and versioned — the queue always pulls the current release.',
    'The <b>Job Queue</b> dispatches each user\u2019s request to an available worker — many jobs run at once, not one desktop at a time.',
    'Workers execute against the internal applications; every action is logged for audit.',
    'Each user sees their own job\u2019s outcome back in the portal — nothing left to guess.'
  ];

  async function runWalkthroughCaptions(myToken){
    const dotsEls = document.querySelectorAll('#wk-dots i');
    const captionEl = document.getElementById('wk-caption');
    let i = 0;
    while(token === myToken){
      captionEl.innerHTML = wkStepText[i];
      dotsEls.forEach(function(d, idx){ d.classList.toggle('on', idx === i); });
      i = (i + 1) % wkStepText.length;
      await delay(2400);
    }
  }

  async function runWalkthroughCicdHeartbeat(myToken){
    const cicd = document.getElementById('wk-cicd');
    while(token === myToken){
      pulse(cicd, null, 900);
      await delay(2200);
    }
  }

  async function userJourney(myToken, user, colorCls, avatarId, portalPath, fanoutPath, mergePath, workerId, startDelay){
    await delay(startDelay);
    const container = document.getElementById('inner-walkthrough');
    const avatar = document.getElementById(avatarId);
    const portal = document.getElementById('wk-portal');
    const auth = document.getElementById('wk-auth');
    const orch = document.getElementById('wk-orch');
    const approval = document.getElementById('wk-approval');
    const cicd = document.getElementById('wk-cicd');
    const queue = document.getElementById('wk-queue');
    const worker = document.getElementById(workerId);
    const apps = document.getElementById('wk-apps');
    const ai = document.getElementById('wk-ai');
    const pendingBadge = document.getElementById('wk-pending');

    while(token === myToken){
      const packet = makePacket(container, colorCls);

      pulse(avatar, colorCls, 700);
      await travel(packet, portalPath, 550); if(token!==myToken){packet.remove();return;}
      pulse(portal, colorCls, 700);
      await travel(packet, wkPaths.portalToAuth, 420); if(token!==myToken){packet.remove();return;}
      pulse(auth, colorCls, 650);
      await travel(packet, wkPaths.authToOrch, 420); if(token!==myToken){packet.remove();return;}
      pulse(orch, colorCls, 650);
      await travel(packet, wkPaths.orchToApproval, 420); if(token!==myToken){packet.remove();return;}
      pulse(approval, colorCls, 650);

      if(user === 'B'){
        pendingBadge.classList.remove('show'); void pendingBadge.offsetWidth; pendingBadge.classList.add('show');
        await delay(1500);
        if(token!==myToken){packet.remove();return;}
      }

      await travel(packet, wkPaths.approvalToCicd, 420); if(token!==myToken){packet.remove();return;}
      pulse(cicd, colorCls, 650);
      await travel(packet, wkPaths.cicdToQueue, 420); if(token!==myToken){packet.remove();return;}
      pulse(queue, colorCls, 650);
      await travel(packet, fanoutPath, 550); if(token!==myToken){packet.remove();return;}
      pulse(worker, colorCls, 650);
      await travel(packet, mergePath, 500); if(token!==myToken){packet.remove();return;}
      pulse(apps, 'success', 650);
      await travel(packet, wkPaths.appsToAi, 420); if(token!==myToken){packet.remove();return;}
      pulse(ai, 'success', 650);
      await delay(300);
      await travel(packet, wkPaths.aiToPortal, 950); if(token!==myToken){packet.remove();return;}
      pulse(portal, 'success', 600);
      await fadeOut(packet, 250);
      if(token!==myToken) return;
      await delay(900 + Math.random()*600);
    }
  }

  function runWalkthrough(myToken){
    runWalkthroughCaptions(myToken);
    runWalkthroughCicdHeartbeat(myToken);
    userJourney(myToken, 'A', 'userA', 'wk-userA', wkPaths.userAToPortal, wkPaths.queueToW1, wkPaths.w1ToApps, 'wk-w1', 0);
    userJourney(myToken, 'B', 'userB', 'wk-userB', wkPaths.userBToPortal, wkPaths.queueToW2, wkPaths.w2ToApps, 'wk-w2', 700);
    userJourney(myToken, 'C', 'userC', 'wk-userC', wkPaths.userCToPortal, wkPaths.queueToW3, wkPaths.w3ToApps, 'wk-w3', 1400);
  }

  // ===================================================================
  // OWNERSHIP & ROLLOUT LOOP
  // ===================================================================
  const ownStepText = [
    'Genie Bot is our tool — the portal, orchestrator, approval engine, queue, and AI layer are ours to design, build, and run.',
    'Only two things on this diagram need IT: plugging into enterprise SSO, and hosting capacity for the worker pool.',
    'That makes this a business team asking for a narrow infrastructure partnership — not an IT project asking to take over a tool we already run.',
    'A joint steering group — our business sponsor plus an IT infrastructure sponsor — keeps ownership clear and unblocks just those two asks.',
    'Pilot first, on the smallest footprint we can get approved — then bring working numbers, not just a diagram, when asking IT to scale hosting for the rest.'
  ];
  const ownedIds = ['own-portal','own-orch','own-approval','own-cicd','own-queue','own-ai'];
  const partnerIds = ['own-auth','own-workers'];

  async function runOwnership(myToken){
    const dotsEls = document.querySelectorAll('#own-dots i');
    const captionEl = document.getElementById('own-caption');
    let i = 0;
    while(token === myToken){
      captionEl.innerHTML = ownStepText[i];
      dotsEls.forEach(function(d, idx){ d.classList.toggle('on', idx === i); });

      if(i === 0){
        ownedIds.forEach(function(id){ pulse(document.getElementById(id), null, 1600); });
      } else if(i === 1){
        partnerIds.forEach(function(id){ pulse(document.getElementById(id), null, 1600); });
      }

      i = (i + 1) % ownStepText.length;
      await delay(2700);
    }
  }

  // ---------- mode switching ----------
  const btnCurrent = document.getElementById('btn-current');
  const btnFuture = document.getElementById('btn-future');
  const btnMigration = document.getElementById('btn-migration');
  const btnWalkthrough = document.getElementById('btn-walkthrough');
  const btnOwnership = document.getElementById('btn-ownership');
  const sceneCurrent = document.getElementById('scene-current');
  const sceneFuture = document.getElementById('scene-future');
  const sceneMigration = document.getElementById('scene-migration');
  const sceneWalkthrough = document.getElementById('scene-walkthrough');
  const sceneOwnership = document.getElementById('scene-ownership');
  const legendCurrent = document.getElementById('legend-current');
  const legendFuture = document.getElementById('legend-future');
  const legendMigration = document.getElementById('legend-migration');
  const legendWalkthrough = document.getElementById('legend-walkthrough');
  const legendOwnership = document.getElementById('legend-ownership');
  const migCaption = document.getElementById('mig-caption');
  const wkCaption = document.getElementById('wk-caption');
  const wkDots = document.getElementById('wk-dots');
  const ownCaption = document.getElementById('own-caption');
  const ownDots = document.getElementById('own-dots');
  const readouts = document.getElementById('readouts');
  const subline = document.getElementById('subline');
  const r1 = document.getElementById('r1'), r2 = document.getElementById('r2'), r3 = document.getElementById('r3');

  const allScenes = [sceneCurrent, sceneFuture, sceneMigration, sceneWalkthrough, sceneOwnership];
  const allLegends = [legendCurrent, legendFuture, legendMigration, legendWalkthrough, legendOwnership];
  const allBtns = [btnCurrent, btnFuture, btnMigration, btnWalkthrough, btnOwnership];
  const allExtras = [migCaption, wkCaption, wkDots, ownCaption, ownDots];

  function activate(btn){
    allBtns.forEach(function(b){ b.classList.remove('on'); b.setAttribute('aria-selected','false'); });
    btn.classList.add('on'); btn.setAttribute('aria-selected','true');
  }
  function showScene(scene, legend, extrasToShow){
    allScenes.forEach(function(s){ s.classList.add('hidden'); });
    allLegends.forEach(function(l){ l.classList.add('hidden'); });
    allExtras.forEach(function(e){ e.classList.add('hidden'); });
    scene.classList.remove('hidden');
    legend.classList.remove('hidden');
    (extrasToShow || []).forEach(function(e){ e.classList.remove('hidden'); });
  }

  function goCurrent(){
    token++;
    activate(btnCurrent);
    showScene(sceneCurrent, legendCurrent);
    readouts.classList.remove('hidden');
    readouts.querySelectorAll('.readout').forEach(function(el){ el.classList.add('dim'); });
    r1.textContent='--'; r2.textContent='--'; r3.textContent='--';
    subline.textContent = 'One Genie Bot job, one desktop — multiply that by ~250 bots and many users, and nobody downstream can see whether it actually worked, or whether two people just triggered the same one.';
    runCurrent(token);
  }
  function goFuture(){
    token++;
    activate(btnFuture);
    showScene(sceneFuture, legendFuture);
    readouts.classList.remove('hidden');
    readouts.querySelectorAll('.readout').forEach(function(el){ el.classList.remove('dim'); });
    subline.textContent = 'The same ~250 bots, built from the existing GitHub codebase, run on an auto-scaling worker pool — many users, many jobs, at once — watched end to end and self-healed when one fails.';
    runFuture(token);
  }
  function goMigration(){
    token++;
    activate(btnMigration);
    showScene(sceneMigration, legendMigration, [migCaption]);
    readouts.classList.add('hidden');
    subline.textContent = 'Each task that runs on a user\u2019s desktop today has a direct replacement on the platform — the same ~250 bots, still sourced from GitHub, now centrally managed and multi-user ready.';
    runMigration(token);
  }
  function goWalkthrough(){
    token++;
    activate(btnWalkthrough);
    showScene(sceneWalkthrough, legendWalkthrough, [wkCaption, wkDots]);
    readouts.classList.add('hidden');
    subline.textContent = 'Three users, three teams, one platform — each logs in, gets approved where needed, and their job runs on a shared, auto-scaling pool instead of their own desktop.';
    runWalkthrough(token);
  }
  function goOwnership(){
    token++;
    activate(btnOwnership);
    showScene(sceneOwnership, legendOwnership, [ownCaption, ownDots]);
    readouts.classList.add('hidden');
    subline.textContent = 'Genie Bot is already ours — this is what we keep building and running ourselves, versus the two things we need IT to partner on.';
    runOwnership(token);
  }

  btnCurrent.addEventListener('click', goCurrent);
  btnFuture.addEventListener('click', goFuture);
  btnMigration.addEventListener('click', goMigration);
  btnWalkthrough.addEventListener('click', goWalkthrough);
  btnOwnership.addEventListener('click', goOwnership);

  // initial state
  goCurrent();
})();
</script>
</body>
</html>
